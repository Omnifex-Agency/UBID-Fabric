# UBID Fabric v0.2 — Example Environment Configuration
# Copy this to .env and fill in your values

DATABASE_URL=postgresql://ubid_fabric:ubid_dev_2026@localhost:5432/ubid_fabric
REDIS_URL=redis://localhost:6379/0

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Conflict & Retry Settings
CONFLICT_WINDOW_SECONDS=30
MAX_SAGA_RETRIES=5
IDEMPOTENCY_TTL_SECONDS=604800

# AI Integration
# Switch to "gemini" for cloud, "ollama" for on-premise (no PII leaves your server)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3
# For Gemini: set AI_PROVIDER=gemini and add your key below
# AI_API_KEY=your-gemini-api-key-here

# Security
# Comma-separated list of allowed IP ranges for inbound webhooks (leave empty to allow all)
# ALLOWED_WEBHOOK_IPS=10.0.0.0/8,192.168.0.0/16

# Shared HMAC secret for verifying department payload signatures
WEBHOOK_SIGNATURE_SECRET=ubid-fabric-shared-secret
