# ═══════════════════════════════════════════════════════════════
# UBID Fabric — Configuration Environment
# ═══════════════════════════════════════════════════════════════

# --- Infrastructure ---
DATABASE_URL=postgresql://ubid_fabric:ubid_dev_2026@localhost:5432/ubid_fabric
REDIS_URL=redis://localhost:6379/0

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=DEBUG

# --- AI CONFIGURATION ---
# Options: "ollama" (Local) or "gemini" (Cloud)
AI_PROVIDER=ollama

# If using Ollama (Local):
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3

# If using Gemini (Cloud):
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-1.5-flash

# --- Conflict & Governance ---
CONFLICT_WINDOW_SECONDS=30
RECONCILIATION_INTERVAL_SECONDS=21600
MAX_SAGA_RETRIES=5
IDEMPOTENCY_TTL_SECONDS=604800
